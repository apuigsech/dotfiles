{
  "awsAuthRefresh": "aws sso login --profile claude",
  "skillListingBudgetFraction": 0.02,
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(AWS_PROFILE=app-reboot-agents task sandbox:stop SANDBOX_ID=i*-agent -- --yes)",
      "Bash(AWS_PROFILE=app-reboot-agents task sandbox:stop SANDBOX_ID=e2e-* -- --yes)",
      "Bash(AWS_PROFILE=app-reboot-agents task e2e:run)",
      "Bash(AWS_PROFILE=app-reboot-agents aws cloudformation delete-stack --stack-name amplify-appbackend-*-sandbox-*)",
      "Bash(task operators:add EMAIL=* SANDBOX_ID=i*-agent *)"
    ],
    "deny": [
      "Bash(*task *operators:*ENV=*)",
      "Bash(*ENV=* task *operators:*)",
      "Bash(*task *operators:*CONFIRM=*)",
      "Bash(*CONFIRM=* task *operators:*)",
      "Bash(*task *operators:*BACKEND=*)",
      "Bash(*task *operators:*BRANCH=*)",
      "Bash(*task *operators:*AMPLIFY_APP_NAME=*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]1337;SetProfile=claude\\a' > /dev/tty 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "~/.claude/gh-auth.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude/hooks/ontopix-app-guard.py ] && /usr/bin/python3 ~/.claude/hooks/ontopix-app-guard.py || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "siesta@siesta": true
  },
  "extraKnownMarketplaces": {
    "siesta": {
      "source": {
        "source": "github",
        "repo": "apuigsech/siesta"
      }
    },
    "ontopix": {
      "source": {
        "source": "github",
        "repo": "ontopix/agents-setup"
      }
    },
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 350000
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
