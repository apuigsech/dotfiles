- defaults:
    link:
      relink: true
      force: true
      create: true

- create:
    - ~/.claude

- link:
    ~/.claude/settings.json: settings.json
    ~/.claude/statusline.sh: statusline.sh
    ~/.shell/claude: enable

- shell:
    - command: chmod +x ~/.dotfiles/plugins/claude/statusline.sh
      description: Make Claude Code status line script executable
