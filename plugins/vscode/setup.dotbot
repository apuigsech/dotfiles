- defaults:
    link:
      relink: true
      create: true

- create:
    - ~/Library/Application Support/Code
    - ~/Library/Application Support/Code/User
    - ~/Library/Application Support/Code/User/snippets

- link:
    # VSCode User Settings
    ~/Library/Application Support/Code/User/settings.json: settings.json

- shell:
    - description: "Setting up VSCode configuration"
      command: |
        # Ensure VSCode directories exist
        mkdir -p ~/Library/Application\ Support/Code/User/snippets

        # Set proper permissions
        chmod 755 ~/Library/Application\ Support/Code
        chmod 755 ~/Library/Application\ Support/Code/User
        chmod 644 ~/Library/Application\ Support/Code/User/settings.json 2>/dev/null || true

        echo "VSCode configuration setup complete"
      stdout: true
      stderr: true
